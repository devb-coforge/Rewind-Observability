# Local development — loaded automatically when you run `uv run obs` from backend/.

# Agent is chosen from the folder name (.claude / .codex / .cursor or claude / codex / cursor).
OBS_SOURCES=$HOME/.claude,$HOME/.codex,$HOME/.cursor
OBS_DATA_DIR=../data
# OBS_HOST=127.0.0.1
# OBS_PORT=8080

# Optional overrides (see config.example.yaml for YAML equivalents):
# OBS_CONFIG=../config.yaml
# OBS_CURSOR_USER_DATA_DIR=/path/to/Cursor/User
# OBS_PRICING_FILE=../pricing.yaml
# OBS_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OBS_OTEL_INCLUDE_CONTENT=false
